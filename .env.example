# Copy this file to .env and fill in the values. .env is git-ignored.

# Demo mode is ON unless this is set to false. In demo mode the chat and the
# reservations page use in-browser mock data and no backend is called.
VITE_USE_MOCK_API=false

# --- Server-side only (read by the proxies, never sent to the browser) ---

# n8n "SupportFlow AI - API" webhook (support chat).
#   Test URL (while "Execute workflow" is listening):  https://<your-n8n-host>/webhook-test/supportflow-ai-api
#   Production URL (once the workflow is published):   https://<your-n8n-host>/webhook/supportflow-ai-api
N8N_WEBHOOK_URL=https://<your-n8n-host>/webhook/supportflow-ai-api

# n8n "SupportFlow AI - Reservations API" webhook.
#   Test URL:        https://<your-n8n-host>/webhook-test/supportflow-reservations
#   Production URL:  https://<your-n8n-host>/webhook/supportflow-reservations
N8N_RESERVATIONS_URL=https://<your-n8n-host>/webhook/supportflow-reservations

# Shared key sent in the X-SupportFlow-Key header. n8n stores only its SHA-256 hash
# (Check API Key node), so a new key also needs a new hash there.
# Used by both workflows.
N8N_WEBHOOK_SECRET=

# --- Optional: only for `npm run build:n8n:local` (rebuilds the n8n workflows with your values) ---
# Output goes to n8n/*/workflow.local.ts, which is git-ignored. The key hash is derived from
# N8N_WEBHOOK_SECRET automatically.
N8N_KB_SHEET_ID=
N8N_TICKETS_SHEET_ID=
N8N_SHEETS_CREDENTIAL_ID=
N8N_GEMINI_CREDENTIAL_ID=
N8N_GMAIL_CREDENTIAL_ID=
SUPPORT_TEAM_EMAIL=
